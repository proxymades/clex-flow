{
  "id": "clex.logic.wifi",
  "version": "1.0.0",
  "kind": "logic",
  "name": "Wi-Fi",
  "description": "Управляет подключением к сети Wi-Fi и сообщает состояние, IPv4 и причину ошибки.",
  "category": "network",
  "categoryName": "Сеть",
  "icon": "Wifi",
  "color": "#22d3ee",
  "inputs": [
    {
      "id": "trigger",
      "name": "Обновить состояние",
      "type": "event",
      "required": false,
      "description": "Запускает действие «Обновить состояние»."
    },
    {
      "id": "connect",
      "name": "Подключиться",
      "type": "event",
      "required": false,
      "description": "Запускает действие «Подключиться»."
    },
    {
      "id": "disconnect",
      "name": "Отключиться",
      "type": "event",
      "required": false,
      "description": "Запускает действие «Отключиться»."
    },
    {
      "id": "reconnect",
      "name": "Переподключиться",
      "type": "event",
      "required": false,
      "description": "Запускает действие «Переподключиться»."
    }
  ],
  "outputs": [
    {
      "id": "changed",
      "name": "Данные сети обновлены",
      "type": "event",
      "required": false,
      "description": "Сигнал: Данные сети обновлены."
    },
    {
      "id": "connected",
      "name": "IP-адрес получен",
      "type": "event",
      "required": false,
      "description": "Сеть доступна и IP-адрес получен."
    },
    {
      "id": "disconnected",
      "name": "Сеть отключена",
      "type": "event",
      "required": false,
      "description": "Сигнал: Соединение потеряно."
    },
    {
      "id": "ipChanged",
      "name": "IP-адрес обновлен",
      "type": "event",
      "required": false,
      "description": "Сигнал: IP-адрес обновлен."
    },
    {
      "id": "failed",
      "name": "Ошибка подключения",
      "type": "event",
      "required": false,
      "description": "Сигнал: Ошибка подключения."
    },
    {
      "id": "state",
      "name": "Состояние подключения",
      "type": "number",
      "required": false,
      "description": "Передаёт число: Состояние подключения.",
      "readyOn": "changed",
      "valueStates": {
        "initialValue": 0,
        "fallbackValue": 4,
        "options": [
          {
            "value": 0,
            "label": "Отключено",
            "dotColor": "#97a6bd"
          },
          {
            "value": 1,
            "label": "Подключение",
            "dotColor": "#fbbf24"
          },
          {
            "value": 2,
            "label": "Ожидание IP",
            "dotColor": "#fbbf24"
          },
          {
            "value": 3,
            "label": "IP получен",
            "dotColor": "#34d399"
          },
          {
            "value": 4,
            "label": "Ошибка",
            "dotColor": "#ef6666"
          }
        ]
      }
    },
    {
      "id": "ip",
      "name": "IP-адрес устройства",
      "type": "text",
      "required": false,
      "description": "Передаёт текст: IP-адрес устройства.",
      "readyOn": "changed"
    },
    {
      "id": "netmask",
      "name": "Маска подсети",
      "type": "text",
      "required": false,
      "description": "Передаёт текст: Маска подсети.",
      "readyOn": "changed"
    },
    {
      "id": "gateway",
      "name": "Шлюз",
      "type": "text",
      "required": false,
      "description": "Передаёт текст: Шлюз.",
      "readyOn": "changed"
    },
    {
      "id": "dns",
      "name": "DNS-сервер",
      "type": "text",
      "required": false,
      "description": "Передаёт текст: DNS-сервер.",
      "readyOn": "changed"
    },
    {
      "id": "reasonCode",
      "name": "Код причины отключения",
      "type": "number",
      "required": false,
      "description": "Передаёт число: Код причины отключения.",
      "readyOn": "changed"
    },
    {
      "id": "error",
      "name": "Описание ошибки",
      "type": "text",
      "required": false,
      "description": "Передаёт текст: Ошибка подключения.",
      "readyOn": "changed"
    },
    {
      "id": "isConnected",
      "name": "Есть подключение?",
      "type": "boolean",
      "required": false,
      "description": "Текущее соединение с сетью Wi-Fi.",
      "readyOn": "changed"
    }
  ],
  "parameters": {
    "componentId": {
      "label": "Wi-Fi-подключение",
      "type": "component",
      "default": ""
    }
  },
  "constraints": {
    "hardware": {
      "kind": "wifi",
      "modules": [
        "clex.hardware.wifi"
      ]
    }
  },
  "compatibility": {
    "projectFormat": 4,
    "targets": [
      "esp32",
      "esp32s3",
      "esp32p4"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "wifi",
    "eventSource": true
  },
  "displayResetEvent": "ipChanged"
}
