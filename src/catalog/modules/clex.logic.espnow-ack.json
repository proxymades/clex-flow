{
  "id": "clex.logic.espnow-ack",
  "version": "2.0.0",
  "kind": "logic",
  "name": "Подтвердить команду ESP-NOW",
  "description": "Подтверждает выполнение текущей команды или сообщает об ошибке.",
  "category": "network",
  "categoryName": "Сеть",
  "icon": "Radio",
  "color": "#f472b6",
  "inputs": [
    {
      "id": "trigger",
      "name": "Команда выполнена",
      "type": "event",
      "description": "Отправляет подтверждение успешного выполнения текущей команды."
    },
    {
      "id": "reject",
      "name": "Команда не выполнена",
      "type": "event",
      "description": "Отправляет отрицательное подтверждение текущей команды."
    }
  ],
  "outputs": [
    {
      "id": "done",
      "name": "Ответ отправлен",
      "type": "event",
      "description": "Ответ передан радиодрайверу."
    },
    {
      "id": "failed",
      "name": "Ответ не отправлен",
      "type": "event",
      "description": "Нет ожидающей команды или ответ не удалось отправить."
    },
    {
      "id": "error",
      "name": "Причина ошибки",
      "type": "text",
      "description": "Ошибка подтверждения.",
      "readyOn": "failed",
      "additional": true
    }
  ],
  "parameters": {
    "componentId": {
      "label": "ESP-NOW",
      "type": "component",
      "default": ""
    }
  },
  "constraints": {
    "hardware": {
      "kind": "radio",
      "modules": [
        "clex.hardware.espnow"
      ]
    }
  },
  "compatibility": {
    "projectFormat": 3,
    "targets": [
      "esp32s3"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "espnow-ack",
    "eventSource": false,
    "dependencies": [
      "esp_wifi"
    ]
  }
}
