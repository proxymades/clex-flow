{
  "id": "clex.logic.gpio-set",
  "version": "1.0.0",
  "kind": "logic",
  "name": "Управлять выходом",
  "description": "Включает, выключает или переключает светодиод, MOSFET-ключ или реле. Подключите событие к нужной команде. При запуске выход выключен.",
  "category": "gpio",
  "categoryName": "Кнопки и выходы",
  "icon": "ArrowUpRight",
  "color": "#8B5CF6",
  "inputs": [
    {
      "id": "on",
      "name": "Включить",
      "type": "event",
      "description": "Включает выбранный выход."
    },
    {
      "id": "off",
      "name": "Выключить",
      "type": "event",
      "description": "Выключает выбранный выход."
    },
    {
      "id": "toggle",
      "name": "Переключить",
      "type": "event",
      "description": "Включает выключенный выход или выключает включённый."
    }
  ],
  "outputs": [
    {
      "id": "on",
      "name": "Выход включён",
      "type": "event",
      "description": "Сигнал после команды, если выход включён. Это заданное состояние, обратная связь от нагрузки не считывается."
    },
    {
      "id": "off",
      "name": "Выход выключен",
      "type": "event",
      "description": "Сигнал после команды, если выход выключен. Это заданное состояние, обратная связь от нагрузки не считывается."
    },
    {
      "id": "done",
      "name": "Команда выполнена",
