{
  "id": "clex.logic.serial",
  "version": "1.0.0",
  "kind": "logic",
  "name": "Сообщение в монитор",
  "description": "Вывести текст и необязательное число по событию.",
  "category": "output",
  "categoryName": "Вывод",
  "icon": "Terminal",
  "color": "#FB923C",
  "inputs": [
    {
      "id": "trigger",
      "name": "Вывести сообщение",
      "type": "event",
      "required": true,
      "description": "Выводит подготовленное сообщение в монитор порта.",
      "additional": false
    },
    {
      "id": "text",
      "name": "Текст сообщения",
      "type": "text",
      "required": false,
      "description": "Принимает текст вместо текста из настроек.",
      "additional": true
    },
    {
      "id": "number",
      "name": "Число в сообщении",
      "type": "number",
      "required": false,
      "description": "Добавляет число к сообщению через пробел.",
      "additional": true
    }
  ],
  "outputs": [
    {
      "id": "done",
      "name": "Сообщение выведено",
      "type": "event",
      "required": false,
      "description": "Отправляет сигнал после вывода сообщения.",
      "additional": true
    },
    {
      "id": "text",
      "name": "Выведенный текст",
      "type": "text",
      "required": false,
      "readyOn": "done",
      "description": "Передает полный сформированный текст сообщения.",
      "additional": true
    }
  ],
  "parameters": {
    "message": {
      "label": "Текст без входной связи",
      "type": "text",
      "default": "Сообщение CLEX Flow",
      "maxLength": 2000,
      "description": "Используется, если текст не поступает от другого блока."
    }
  },
  "constraints": {},
  "compatibility": {
    "projectFormat": 3,
    "targets": [
      "esp32s3"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "serial",
    "dependencies": [
      "log"
    ]
  }
}
