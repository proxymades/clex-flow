      "esp32p4",
      "atmega328p"
    ],
    "espIdf": "5.4.4",
    "platforms": {
      "arduino-avr": "1.8.6"
    }
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "counter",
    "dependencies": []
  },
  "legacyNames": [
    "Счётчик"
  ]
