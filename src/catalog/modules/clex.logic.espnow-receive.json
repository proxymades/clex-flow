{
  "id": "clex.logic.espnow-receive",
  "version": "2.0.0",
  "kind": "logic",
  "name": "Получено ESP-NOW",
  "description": "Получает сообщения или команды с указанным именем от устройств из списка.",
  "category": "network",
  "categoryName": "Сеть",
  "icon": "Radio",
  "color": "#f472b6",
  "inputs": [],
  "outputs": [
    {
      "id": "messageReceived",
      "name": "Сообщение получено",
      "type": "event",
      "description": "Срабатывает один раз для нового сообщения.",
      "when": {
        "field": "transferType",
        "value": "message"
      }
    },
    {
      "id": "commandReceived",
      "name": "Команда получена",
      "type": "event",
      "description": "Срабатывает один раз для новой команды с указанным именем.",
      "when": {
        "field": "transferType",
        "value": "command"
      }
    },
    {
      "id": "text",
      "name": "Текст сообщения",
      "type": "text",
      "description": "Принятый текст UTF-8.",
      "readyOn": "messageReceived"
    },
    {
      "id": "sender",
      "name": "MAC отправителя",
      "type": "text",
      "description": "MAC разрешенного отправителя.",
      "readyOn": "messageReceived"
    },
    {
      "id": "rssi",
      "name": "RSSI последнего пакета, дБм",
      "type": "number",
      "description": "Измерение в момент приема пакета; сохраняется до следующего пакета и не означает наличие связи. -127: API не передал RSSI. Для текущей связи используйте управление ESP-NOW → Следить за устройством.",
      "readyOn": "messageReceived",
      "additional": true
    },
    {
      "id": "command",
      "name": "Имя команды",
      "type": "text",
      "description": "Имя полученной команды.",
      "readyOn": "commandReceived",
      "when": {
        "field": "transferType",
        "value": "command"
      }
    }
  ],
  "parameters": {
    "componentId": {
      "label": "ESP-NOW",
      "type": "component",
      "default": ""
    },
    "transferType": {
      "label": "Тип приема",
      "type": "select",
      "default": "message",
      "options": [
        {
          "value": "message",
          "label": "Сообщение"
        },
        {
          "value": "command",
          "label": "Команда"
        }
      ]
    },
    "command": {
      "label": "Имя команды",
      "type": "text",
      "default": "SET_LR",
      "maxLength": 32,
      "when": {
        "field": "transferType",
        "value": "command"
      }
    }
  },
  "constraints": {
    "hardware": {
      "kind": "radio",
      "modules": [
        "clex.hardware.espnow"
      ]
    }
  },
  "compatibility": {
    "projectFormat": 3,
    "targets": [
      "esp32",
      "esp32s3"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "espnow-receive",
    "eventSource": true,
    "dependencies": [
      "esp_wifi"
    ]
  }
}
