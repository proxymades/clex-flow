{
  "version": "1.0.0",
  "category": "network",
  "categoryName": "Сеть",
  "icon": "Network",
  "color": "#38bdf8",
  "compatibility": {
    "projectFormat": 4,
    "targets": [
      "esp32",
      "esp32s2",
      "esp32s3",
      "esp32c3",
      "esp32c6",
      "esp32p4"
    ],
    "espIdf": "5.4.4"
  },
  "constraints": {
    "hardware": {
      "kind": "router",
      "modules": [
        "clex.hardware.router"
      ]
    }
  },
  "id": "clex.logic.router",
  "kind": "logic",
  "name": "Маршрутизатор",
  "description": "Состояние, реальные проверки интернета, клиенты и управление маршрутизатором. События выполняются в задаче графа.",
  "inputs": [
    {
      "id": "trigger",
      "name": "Запросить состояние",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Запросить состояние»."
    },
    {
      "id": "start",
      "name": "Запустить",
      "type": "event",
      "additional": false,
      "description": "Запускает действие «Запустить»."
    },
    {
      "id": "stop",
      "name": "Остановить",
      "type": "event",
      "additional": false,
      "description": "Запускает действие «Остановить»."
    },
    {
      "id": "apOn",
      "name": "Включить точку доступа",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Включить SoftAP»."
    },
    {
      "id": "apOff",
      "name": "Выключить точку доступа",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Выключить SoftAP»."
    },
    {
      "id": "reconnect",
      "name": "Переподключить WAN",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Переподключить WAN»."
    },
    {
      "id": "clients",
      "name": "Обновить список клиентов",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Обновить список клиентов»."
    },
    {
      "id": "applyAp",
      "name": "Применить SSID/пароль SoftAP",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Применить SSID/пароль SoftAP»."
    },
    {
      "id": "applyWan",
      "name": "Применить SSID/пароль WAN",
      "type": "event",
      "additional": true,
      "description": "Запускает действие «Применить SSID/пароль WAN»."
    },
    {
      "id": "ssid",
      "name": "Новый SSID",
      "type": "text",
      "required": false,
      "additional": true,
      "description": "Передаёт текст: Новый SSID."
    },
    {
      "id": "password",
      "name": "Новый пароль",
      "type": "text",
      "required": false,
      "additional": true,
      "description": "Передаёт текст: Новый пароль."
    }
  ],
  "outputs": [
    {
      "id": "changed",
      "name": "Состояние обновлено",
      "type": "event",
      "additional": true,
      "description": "Сигнал: Состояние обновлено."
    },
    {
      "id": "started",
      "name": "Маршрутизатор запущен",
      "type": "event",
      "additional": false,
      "description": "Сигнал: Маршрутизатор запущен."
    },
    {
      "id": "wanConnected",
      "name": "WAN подключен",
      "type": "event",
      "additional": false,
      "description": "Сигнал: WAN подключен."
    },
    {
      "id": "wanDisconnected",
      "name": "WAN отключен",
      "type": "event",
      "additional": false,
      "description": "Сигнал: WAN отключен."
    },
    {
      "id": "ipChanged",
      "name": "WAN IP изменен",
      "type": "event",
      "additional": true,
      "description": "Сигнал: WAN IP изменен."
    },
    {
      "id": "internetUp",
      "name": "Интернет доступен",
      "type": "event",
      "additional": true,
      "description": "Сигнал: Интернет доступен."
    },
    {
      "id": "internetDown",
      "name": "Интернет недоступен",
      "type": "event",
      "additional": true,
      "description": "Сигнал: Интернет недоступен."
    },
    {
      "id": "clientConnected",
      "name": "Wi-Fi-клиент подключился",
      "type": "event",
      "additional": true,
      "description": "Сигнал: Wi-Fi-клиент подключился."
    },
    {
      "id": "clientDisconnected",
      "name": "Wi-Fi-клиент отключился",
      "type": "event",
      "additional": true,
      "description": "Сигнал: Wi-Fi-клиент отключился."
    },
    {
      "id": "failed",
      "name": "Ошибка маршрутизатора",
      "type": "event",
      "additional": false,
      "description": "Сигнал: Ошибка маршрутизатора."
    },
    {
      "id": "wanIp",
      "name": "WAN IP",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: WAN IP."
    },
    {
      "id": "lanIp",
      "name": "LAN IP",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: LAN IP."
    },
    {
      "id": "gateway",
      "name": "Шлюз WAN",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: Шлюз WAN."
    },
    {
      "id": "dns",
      "name": "DNS WAN",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: DNS WAN."
    },
    {
      "id": "wanMac",
      "name": "MAC WAN",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: MAC WAN."
    },
    {
      "id": "lanMac",
      "name": "MAC LAN",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: MAC LAN."
    },
    {
      "id": "activeWan",
      "name": "Активный WAN",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: Активный WAN."
    },
    {
      "id": "clientCount",
      "name": "Wi-Fi-клиентов",
      "type": "number",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт число: Wi-Fi-клиентов."
    },
    {
      "id": "clients",
      "name": "Список Wi-Fi-клиентов",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: Список Wi-Fi-клиентов."
    },
    {
      "id": "uptime",
      "name": "Время работы, с",
      "type": "number",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт число: Время работы, с."
    },
    {
      "id": "error",
      "name": "Ошибка",
      "type": "text",
      "readyOn": "changed",
      "additional": true,
      "description": "Передаёт текст: Ошибка."
    },
    {
      "id": "apStarted",
      "name": "Точка доступа включена",
      "type": "event",
      "description": "Точка доступа включена. Сигнал при изменении состояния локальной Wi-Fi-сети.",
      "additional": true
    },
    {
      "id": "apStopped",
      "name": "Точка доступа выключена",
      "type": "event",
      "description": "Точка доступа выключена. Сигнал при изменении состояния локальной Wi-Fi-сети.",
      "additional": true
    }
  ],
  "parameters": {
    "componentId": {
      "label": "Маршрутизатор из монтажа",
      "type": "component",
      "default": ""
    },
    "ssid": {
      "label": "Новый SSID",
      "type": "text",
      "default": "CLEX Flow",
      "maxLength": 32
    },
    "password": {
      "label": "Новый пароль",
      "type": "text",
      "default": "",
      "maxLength": 63
    }
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "router",
    "eventSource": true
  }
}
