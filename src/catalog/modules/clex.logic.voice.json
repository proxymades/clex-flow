{
  "id": "clex.logic.voice",
  "version": "1.0.0",
  "kind": "logic",
  "name": "Голосовые команды",
  "description": "Передаёт отдельное событие для каждой команды выбранного голосового компонента.",
  "category": "audio",
  "categoryName": "Аудио",
  "icon": "MicAudioLines",
  "color": "#a78bfa",
  "inputs": [],
  "outputs": [
    {
      "id": "recognized",
      "name": "Команда распознана",
      "type": "event",
      "description": "Сигнал: Команда распознана."
    },
    {
      "id": "phrase",
      "name": "Текст команды",
      "type": "text",
      "readyOn": "recognized",
      "description": "Передаёт текст: Текст команды."
    },
    {
      "id": "commandId",
      "name": "ID команды",
      "type": "text",
      "readyOn": "recognized",
      "description": "Передаёт текст: ID команды."
    },
    {
      "id": "activated",
      "name": "Активация",
      "type": "event",
      "description": "Сигнал: Активация."
    },
    {
      "id": "uncertain",
      "name": "Повторить команду",
      "type": "event",
      "description": "Срабатывает, когда команда неизвестна или распознана неуверенно во время приёма команд. Можно подключить блок «Воспроизвести запись» с просьбой повторить."
    },
    {
      "id": "closed",
      "name": "Окно закрыто",
      "type": "event",
      "description": "Сигнал: Окно закрыто."
    },
    {
      "id": "failed",
      "name": "Ошибка",
      "type": "event",
      "description": "Сигнал: Ошибка."
    },
    {
      "id": "error",
      "name": "Описание ошибки",
      "type": "text",
      "readyOn": "failed",
      "description": "Передаёт текст: Описание ошибки."
    }
  ],
  "parameters": {
    "componentId": {
      "label": "Голосовой компонент",
      "type": "component",
      "default": ""
    }
  },
  "constraints": {
    "hardware": {
      "kind": "voice",
      "modules": [
        "clex.hardware.voice"
      ]
    }
  },
  "compatibility": {
    "projectFormat": 4,
    "targets": [
      "esp32p4",
      "esp32s3"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "voice",
    "eventSource": true
  }
}
