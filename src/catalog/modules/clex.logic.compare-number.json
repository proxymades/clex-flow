      "description": "Сигнал: Условие не выполнено."
    },
    {
      "id": "below",
      "name": "Ниже диапазона",
      "type": "event",
      "when": {
        "field": "mode",
        "value": "range"
      },
      "description": "Сигнал: Ниже диапазона."
    },
    {
      "id": "inside",
      "name": "В диапазоне",
      "type": "event",
      "when": {
        "field": "mode",
        "value": "range"
      },
      "description": "Сигнал: В диапазоне."
    },
    {
      "id": "above",
      "name": "Выше диапазона",
      "type": "event",
      "when": {
        "field": "mode",
        "value": "range"
      },
      "description": "Сигнал: Выше диапазона."
    },
    {
      "id": "failed",
      "name": "Ошибка сравнения",
      "type": "event",
      "description": "Сигнал: Ошибка сравнения."
    },
    {
      "id": "value",
      "name": "Проверенное число",
      "type": "number",
