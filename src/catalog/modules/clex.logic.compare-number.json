        "field": "mode",
        "value": "compare"
      },
      "description": "Абсолютный допуск только для равно и не равно. 0 означает точное сравнение."
    },
    "lower": {
      "label": "Нижняя граница",
      "type": "number",
      "default": 0,
      "min": -1000000000000,
      "max": 1000000000000,
      "step": "any",
      "when": {
        "field": "mode",
        "value": "range"
      }
    },
    "upper": {
      "label": "Верхняя граница",
      "type": "number",
      "default": 100,
      "min": -1000000000000,
      "max": 1000000000000,
      "step": "any",
      "when": {
        "field": "mode",
        "value": "range"
      }
    },
    "includeLower": {
      "label": "Включать нижнюю границу",
      "type": "boolean",
      "default": true,
      "trueLabel": "Да",
      "falseLabel": "Нет",
      "when": {
        "field": "mode",
        "value": "range"
      }
    },
    "includeUpper": {
      "label": "Включать верхнюю границу",
      "type": "boolean",
      "default": true,
      "trueLabel": "Да",
      "falseLabel": "Нет",
      "when": {
        "field": "mode",
        "value": "range"
      }
    }
  },
