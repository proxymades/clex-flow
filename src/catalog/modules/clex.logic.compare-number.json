        },
        {
          "value": "neq",
          "label": "Не равно (≠)"
        },
        {
          "value": "gte",
          "label": "Больше или равно (≥)"
        },
        {
          "value": "gt",
          "label": "Больше (>)"
        }
      ]
    },
