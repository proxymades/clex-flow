{
  "id": "clex.logic.compare-number",
  "version": "1.0.0",
  "kind": "logic",
  "name": "Сравнение числа",
  "description": "Сравнивает число с порогом или определяет его положение относительно диапазона. Выдаёт событие результата проверки или ошибки. Выполняется по входному сигналу.",
  "category": "values",
  "categoryName": "Данные",
  "icon": "GitBranch",
  "color": "#fbbf24",
  "inputs": [
    {
      "id": "trigger",
      "name": "Проверить",
      "type": "event",
      "required": true,
      "description": "Запускает действие «Проверить»."
    },
    {
      "id": "value",
      "name": "Проверяемое число",
      "type": "number",
      "required": true,
      "sample": "latest",
      "description": "Передаёт число: Проверяемое число."
    },
    {
      "id": "reference",
      "name": "Число для сравнения",
      "type": "number",
      "sample": "latest",
      "when": {
        "field": "mode",
        "value": "compare"
      },
      "description": "Передаёт число: Число для сравнения."
    },
    {
      "id": "lower",
      "name": "Нижняя граница",
      "type": "number",
      "sample": "latest",
      "when": {
        "field": "mode",
        "value": "range"
      },
      "description": "Передаёт число: Нижняя граница."
    },
    {
      "id": "upper",
      "name": "Верхняя граница",
      "type": "number",
      "sample": "latest",
      "when": {
        "field": "mode",
        "value": "range"
      },
      "description": "Передаёт число: Верхняя граница."
    }
  ],
  "outputs": [
    {
      "id": "changed",
      "name": "Проверка завершена",
      "type": "event",
      "description": "Сигнал после каждой проверки, включая ошибку. Числовой результат обновлён."
    },
    {
      "id": "matched",
      "name": "Условие выполнено",
      "type": "event",
