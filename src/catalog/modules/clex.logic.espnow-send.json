{
  "id": "clex.logic.espnow-send",
  "version": "2.0.0",
  "kind": "logic",
  "name": "Отправить ESP-NOW",
  "description": "Передает текстовое сообщение или команду выбранному устройству и ожидает соответствующий ответ.",
  "category": "network",
  "categoryName": "Сеть",
  "icon": "Radio",
  "color": "#f472b6",
  "inputs": [
    {
      "id": "trigger",
      "name": "Отправить",
      "type": "event",
      "description": "Запускает один обмен с выбранным устройством.",
      "required": true
    },
    {
      "id": "text",
      "name": "Текст",
      "type": "text",
      "description": "Необязательный текст вместо настройки блока.",
      "additional": true
    }
  ],
  "outputs": [
    {
      "id": "accepted",
      "name": "Сообщение принято",
      "type": "event",
      "description": "Получатель принял текст. Выполнение дальнейших действий этим ответом не подтверждается.",
      "when": {
        "field": "transferType",
        "value": "message"
      }
    },
    {
      "id": "completed",
      "name": "Команда выполнена",
      "type": "event",
      "description": "Получатель явно подтвердил результат обработки команды.",
      "when": {
        "field": "transferType",
        "value": "command"
      }
    },
    {
      "id": "failed",
      "name": "Отправка не выполнена",
      "type": "event",
      "description": "Ошибка, отрицательное подтверждение или истекло время ожидания."
    },
    {
      "id": "error",
      "name": "Причина ошибки",
      "type": "text",
      "description": "Причина неудачного обмена.",
      "readyOn": "failed",
      "additional": true
    }
  ],
  "parameters": {
    "componentId": {
      "label": "ESP-NOW",
      "type": "component",
      "default": ""
    },
    "transferType": {
      "label": "Тип передачи",
      "type": "select",
      "default": "message",
      "options": [
        {
          "value": "message",
          "label": "Сообщение"
        },
        {
          "value": "command",
          "label": "Команда"
        }
      ]
    },
    "peerId": {
      "label": "Удаленное устройство",
      "type": "espnow-peer",
      "default": ""
    },
    "command": {
      "label": "Имя команды",
      "type": "text",
      "default": "SET_LR",
      "maxLength": 32,
      "when": {
        "field": "transferType",
        "value": "command"
      }
    },
    "message": {
      "label": "Текст",
      "type": "text",
      "default": "Привет, CLEX Flow!",
      "maxLength": 160
    }
  },
  "constraints": {
    "hardware": {
      "kind": "radio",
      "modules": [
        "clex.hardware.espnow"
      ]
    }
  },
  "compatibility": {
    "projectFormat": 3,
    "targets": [
      "esp32",
      "esp32s3"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "espnow-send",
    "eventSource": false,
    "dependencies": [
      "esp_wifi"
    ]
  }
}
