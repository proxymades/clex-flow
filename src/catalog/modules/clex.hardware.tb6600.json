{
  "id": "clex.hardware.tb6600",
  "version": "1.0.0",
  "kind": "hardware",
  "name": "TB6600",
  "description": "Импульсный драйвер, схема общего катода: PUL−/DIR−/ENA− к GND. Входы конкретного модуля должны поддерживать 3,3 В либо подключаться через внешний согласователь. Ток и микрошаги выставляются вручную.",
  "category": "motor-drivers",
  "categoryName": "Драйверы двигателей",
  "icon": "RotateCw",
  "color": "#f59e0b",
  "visual": {
    "svg": "stepper-driver.svg",
    "width": 290,
    "height": 335
  },
  "terminals": [
    {
      "id": "step",
      "label": "PUL+ / STEP",
      "kind": "gpio-output",
      "x": 0,
      "y": 125
    },
    {
      "id": "dir",
      "label": "DIR+ / DIR",
      "kind": "gpio-output",
      "x": 0,
      "y": 160
    },
    {
      "id": "enable",
      "label": "ENA+ / ENABLE",
      "kind": "gpio-output",
      "x": 0,
      "y": 195
    },
    {
      "id": "logic-ground",
      "label": "PUL−",
      "kind": "ground",
      "x": 0,
      "y": 230
    },
    {
      "id": "dir-ground",
      "label": "DIR−",
      "kind": "ground",
      "x": 0,
      "y": 265
    },
    {
      "id": "enable-ground",
      "label": "ENA−",
      "kind": "ground",
      "x": 0,
      "y": 300
    },
    {
      "id": "a1",
      "label": "A+",
      "kind": "winding-output",
      "x": 290,
      "y": 125,
      "phase": "A",
      "right": true
    },
    {
      "id": "a2",
      "label": "A−",
      "kind": "winding-output",
      "x": 290,
      "y": 160,
      "phase": "A",
      "right": true
    },
    {
      "id": "b1",
      "label": "B+",
      "kind": "winding-output",
      "x": 290,
      "y": 195,
      "phase": "B",
      "right": true
    },
    {
      "id": "b2",
      "label": "B−",
      "kind": "winding-output",
      "x": 290,
      "y": 230,
      "phase": "B",
      "right": true
    }
  ],
  "parameters": {
    "microsteps": {
      "label": "Микрошаги на драйвере",
      "type": "select",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Полный шаг"
        },
        {
          "value": "2",
          "label": "1/2"
        },
        {
          "value": "4",
          "label": "1/4"
        },
        {
          "value": "8",
          "label": "1/8"
        },
        {
          "value": "16",
          "label": "1/16"
        },
        {
          "value": "32",
          "label": "1/32"
        }
      ],
      "description": "Укажите режим, который установлен вручную на драйвере. Настройка используется для расчета оборотов, она не переключает DIP/MS/UART."
    },
    "enableLevel": {
      "label": "ENABLE: уровень разрешения",
      "type": "select",
      "default": "low",
      "options": [
        {
          "value": "low",
          "label": "LOW"
        },
        {
          "value": "high",
          "label": "HIGH"
        }
      ],
      "description": "Уровень GPIO, разрешающий движение. По умолчанию LOW: у распространенных TB6600 активный ENA включает свободный ход. Сверьте полярность своего модуля."
    },
    "invertDirection": {
      "label": "Инверсия направления",
      "type": "select",
      "default": "no",
      "options": [
        {
          "value": "no",
          "label": "Нет"
        },
        {
          "value": "yes",
          "label": "Да"
        }
      ]
    },
    "pulseUs": {
      "label": "Длительность STEP, мкс",
      "type": "number",
      "default": 10,
      "min": 5,
      "max": 100,
      "step": 1
    }
  },
  "constraints": {},
  "inputs": [],
  "outputs": [],
  "compatibility": {
    "projectFormat": 3,
    "targets": [
      "esp32s3",
      "esp32p4"
    ],
    "espIdf": "5.4.4"
  },
  "firmware": {
    "status": "implemented",
    "generatorKey": "stepper",
    "dependencies": [
      "esp_driver_gpio",
      "esp_driver_gptimer"
    ]
  },
  "stepper": {
    "model": "tb6600"
  },
  "manualWiring": [
    "Силовое питание подключается вручную: плюс к VCC, минус к GND питания, по маркировке вашего модуля. Не от GPIO.",
    "Ток выставляется вручную на драйвере. Пары проводов обмоток определяются пользователем."
  ]
}
