{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLEX Flow",
  "version": "0.1.0",
  "identifier": "kz.clex.flow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CLEX Flow – Visual Microcontroller Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#0B0D14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Визуальная лаборатория микроконтроллеров",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
